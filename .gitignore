# ============================================================
# Django / Python .gitignore
# ============================================================

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables / secrets
.env
.env.*
!.env.example

# Django
*.log
db.sqlite3
db.sqlite3-journal

# User-uploaded media
media/

# Static files generated by collectstatic
staticfiles/

# Django local settings
local_settings.py

# Testing / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDEs / editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS files
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.orig

# Local development / tooling
.python-version
